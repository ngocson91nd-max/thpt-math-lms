# ==============================================================================
# HỆ THỐNG LMS TOÁN THPT - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Sao chép file này thành .env.local để sử dụng cho môi trường phát triển cục bộ.
# KHÔNG BAO GIỜ cam kết khóa bí mật thật (secret keys) vào Git repository.
# ==============================================================================

# 1. Cấu hình Supabase (Cần thiết cho Auth, Database và Storage)
# Lấy từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Cấu hình Trí tuệ nhân tạo (AI Math Assistant)
# Tùy chọn: Hệ thống vẫn hoạt động đầy đủ bình thường ngay cả khi chưa cấu hình AI.
# Khi được cấu hình, AI sẽ hỗ trợ sinh câu hỏi Toán, giải thích lời giải và gợi ý chấm tự luận.
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# 3. URL Ứng dụng
NEXT_PUBLIC_APP_URL=http://localhost:3000
